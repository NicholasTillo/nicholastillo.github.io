    rotomAnimationNeutral2();
    }
    if(randomNum == 2){
    rotomAnimationNeutral3();
    }
    if(randomNum == 3){
    rotomAnimationNeutral4();
      
    }
    if(randomNum == 4){
    rotomAnimationNeutral5();
      
    }
    if(randomNum == 5){
    rotomAnimationNeutral6();
      
    }
     if(randomNum == 6){
    rotomAnimationNeutral7();
      
    }
    
  }
  if(state == feeding){
    int randomNum = random(3);
    if(randomNum == 0){
      rotomAnimationFeedLeppa();
    }
    else if(randomNum == 1){
      rotomAnimationFeedBanana();
    } 
    else if(randomNum == 2){
      rotomAnimationFeedCheri();
    }
    
  }
}

